upstream mtproto {
    server 127.0.0.1:8446;
}

upstream https_sites {
    server 127.0.0.1:8443;
}

map $ssl_preread_server_name $sni_name {
    hostnames;

    # TG Proxy
    thunboo.ru mtproto;

    # HTTPS Sites
    grafana.thunboo.ru https_sites;
    netbird.thunboo.ru https_sites;

    default mtproto;
}

server {
    listen          443;
    ssl_preread     on;
    proxy_pass      $sni_name;

    #proxy_protocol on;
    set_real_ip_from unix:;
}